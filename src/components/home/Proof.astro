---
// Visual proof — fake behavior-graph UI panel (verbatim port).
// Node palette colors live ONLY inside this SVG, never in chrome.
---

<section class="proof reveal">
  <div class="container">
    <div class="proof__block">
      <div class="fake-ui proof-app">
        <!-- Title bar -->
        <div class="fake-ui__bar">
          <span class="fake-ui__dot"></span>
          <span class="fake-ui__dot"></span>
          <span class="fake-ui__dot"></span>
          <span class="fake-ui__bar-title">kigumi — saas-starter</span>
          <div class="proof-app__phases">
            <span class="proof-app__phase proof-app__phase--done"
              ><span class="proof-app__phase-dot"></span> Import</span
            >
            <span class="proof-app__phase proof-app__phase--active"
              ><span class="proof-app__phase-dot"></span> Build</span
            >
            <span class="proof-app__phase"
              ><span class="proof-app__phase-dot"></span> Verify</span
            >
          </div>
        </div>
        <!-- Toolbar -->
        <div class="proof-app__toolbar">
          <span class="proof-app__legend-item"
            ><span class="proof-app__legend-dot" style="background: #7ab8a0"
            ></span> State</span
          >
          <span class="proof-app__legend-item"
            ><span class="proof-app__legend-dot" style="background: #d4a054"
            ></span> Action</span
          >
          <span class="proof-app__legend-item"
            ><span class="proof-app__legend-dot" style="background: #c47a6c"
            ></span> Condition</span
          >
          <span class="proof-app__legend-item"
            ><span class="proof-app__legend-dot" style="background: #9a7bb5"
            ></span> Data</span
          >
          <span class="proof-app__legend-item"
            ><span class="proof-app__legend-dot" style="background: #7a9bb8"
            ></span> Event</span
          >
          <span class="proof-app__stat">38 nodes · 47 edges</span>
        </div>
        <!-- Graph canvas -->
        <div class="proof-app__graph">
          <svg viewBox="0 0 640 340" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Edges -->
            <g stroke="#3a3028" stroke-width="1.5">
              <line x1="138" y1="60" x2="190" y2="100" />
              <line x1="138" y1="60" x2="190" y2="200" />
              <line x1="270" y1="120" x2="310" y2="120" />
              <line x1="270" y1="220" x2="310" y2="140" />
              <line x1="420" y1="120" x2="470" y2="65" />
              <line x1="370" y1="142" x2="250" y2="270" />
              <line x1="330" y1="292" x2="380" y2="292" />
              <line x1="250" y1="120" x2="250" y2="270" />
              <line x1="560" y1="65" x2="560" y2="170" />
            </g>
            <!-- Node 1: Splash Screen (State) -->
            <g transform="translate(28, 38)">
              <rect width="120" height="44" rx="6" fill="#1a1410" stroke="#7ab8a0" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#7ab8a0" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                Splash Screen
              </text>
            </g>
            <!-- Node 2: Login (Action) -->
            <g transform="translate(180, 98)">
              <rect width="90" height="44" rx="6" fill="#1a1410" stroke="#d4a054" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#d4a054" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                Login
              </text>
            </g>
            <!-- Node 3: Register (Action) -->
            <g transform="translate(180, 198)">
              <rect width="90" height="44" rx="6" fill="#1a1410" stroke="#d4a054" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#d4a054" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                Register
              </text>
            </g>
            <!-- Node 4: Valid Creds? (Condition) -->
            <g transform="translate(305, 98)">
              <rect width="118" height="44" rx="6" fill="#1a1410" stroke="#c47a6c" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#c47a6c" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                Valid Creds?
              </text>
            </g>
            <!-- Node 5: Dashboard (State) -->
            <g transform="translate(460, 38)">
              <rect width="110" height="44" rx="6" fill="#1a1410" stroke="#7ab8a0" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#7ab8a0" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                Dashboard
              </text>
            </g>
            <!-- Node 6: Forgot Password (Action) -->
            <g transform="translate(170, 270)">
              <rect width="150" height="44" rx="6" fill="#1a1410" stroke="#d4a054" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#d4a054" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                Forgot Password
              </text>
            </g>
            <!-- Node 7: Send Reset Email (Event) -->
            <g transform="translate(370, 270)">
              <rect width="155" height="44" rx="6" fill="#1a1410" stroke="#7a9bb8" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#7a9bb8" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                Send Reset Email
              </text>
            </g>
            <!-- Node 8: User Session (Data) -->
            <g transform="translate(475, 165)">
              <rect width="125" height="44" rx="6" fill="#1a1410" stroke="#9a7bb5" stroke-width="1.5" />
              <rect x="1" y="8" width="3" height="28" rx="1.5" fill="#9a7bb5" />
              <text x="18" y="27" font-family="'JetBrains Mono', monospace" font-size="10" fill="#c8b89a">
                User Session
              </text>
            </g>
          </svg>
        </div>
        <!-- Bottom dock -->
        <div class="proof-app__dock">
          <span class="proof-app__tab proof-app__tab--active">Scheme</span>
          <span class="proof-app__tab">PRD</span>
          <span class="proof-app__tab">Decisions</span>
        </div>
      </div>
    </div>
  </div>
</section>
